# 专体共享后端 · 环境变量模板（本地 Demo，无真实密钥）
# 复制为 .env 后按需修改；.env 不入库（已在根 .gitignore 排除 .env*）

# 服务端口
PORT=8787

# 本地数据库文件路径（gitignore 内，不入库）
DB_PATH=./data/app.db

# JWT 签名密钥 —— 仅本地演示用默认值，禁止用于生产；生产环境通过安全渠道注入
JWT_SECRET=local-demo-secret-change-me

# 访问令牌有效期（分钟）与刷新令牌有效期（天）
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAY=7
