{
  "name": "@person-sports/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:rollback": "tsx src/db-cli.ts rollback",
    "db:seed": "tsx db/seed/seed.ts",
    "db:reset": "tsx src/db-cli.ts reset",
    "db:backup": "tsx src/db-cli.ts backup"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^4.29.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
